{
  "$schema": "https://frictionlessdata.io/schemas/table-schema.json",
  "name": "odas-app-bevoelkerungsentwicklung",
  "title": "Bevölkerungsentwicklung",
  "fields": [
    {
      "name": "MONATSZAHL",
      "title": "Thema (Monatszahl)",
      "type": "string",
      "description": "Thema der Monatszahl, z. B. Altersgruppen.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "AUSPRAEGUNG",
      "title": "Ausprägung",
      "type": "string",
      "description": "Ausprägung innerhalb des Themas, z. B. eine Altersgruppe.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "JAHR",
      "title": "Jahr",
      "type": "year",
      "description": "Kalenderjahr als vierstellige Zahl.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "MONAT",
      "title": "Monat (JJJJMM)",
      "type": "yearmonth",
      "format": "%Y%m",
      "description": "Berichtsmonat als sechsstellige Zahl JJJJMM.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "WERT",
      "title": "Wert",
      "type": "number",
      "description": "Gemessener Monatswert (z. B. Einwohnerzahl).",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "VORJAHRESWERT",
      "title": "Vorjahreswert",
      "type": "number",
      "description": "Wert des Vorjahresmonats.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "VERAEND_VORMONAT_PROZENT",
      "title": "Veränderung zum Vormonat (%)",
      "type": "number",
      "description": "Prozentuale Veränderung gegenüber dem Vormonat.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "VERAEND_VORJAHRESMONAT_PROZENT",
      "title": "Veränderung zum Vorjahresmonat (%)",
      "type": "number",
      "description": "Prozentuale Veränderung gegenüber dem Vorjahresmonat.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "ZWOELF_MONATE_MITTELWERT",
      "title": "12-Monate-Mittelwert",
      "type": "number",
      "description": "Mittelwert der letzten zwölf Monate.",
      "constraints": {
        "required": false
      }
    }
  ]
}
